# Copy to .env and fill in only the keys for the workflows you actually run.
# The offline commands (labels, validate, demo) need none of these.

# Provider-backed generation — `meddies-pii generate`
MIMO_API_KEYS=
OPENCODE_ZEN_API_KEYS=
# OPENCODE_ZEN_API_KEY=          # single-key alternative to OPENCODE_ZEN_API_KEYS
OPENAI_API_KEYS=

# Gemini batch review — `meddies-pii inference`
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=            # only needed for `inference --vertex-ai`

# HuggingFace publish / correction workflows
HF_TOKEN=
